+// ---- holdem-trainer patch -----------------------------------------------------
+// Per-action EV at a given line. See BestResponse.h for why this runs in
+// expected-value mode rather than best-response mode.
+nlohmann::json BestResponse::evsAtLine(shared_ptr<GameTreeNode> root, int player,
+                                       uint64_t initialBoard, const vector<string>& line) {
+    // Build reach from our own combos so every index below refers to the same list.
+    vector<vector<float>> reach_probs(this->player_number);
+    for(int p = 0;p < this->player_number;p ++) {
+        reach_probs[p] = vector<float>(this->private_combos[p].size());
+        for(int i = 0;i < this->private_combos[p].size();i ++)
+            reach_probs[p][i] = this->private_combos[p][i].weight;
+    }
+
+    shared_ptr<GameTreeNode> node = root;
+
+    // Walk the line, rescaling reach probs by the strategy actually taken at each
+    // step. Only the acting player's reach is rescaled -- the other player's hands
+    // are still all live -- which is the same rule the traversal above uses.
+    for(const string& want : line) {
+        if(node->getType() != GameTreeNode::GameTreeNodeType::ACTION)
+            throw runtime_error(fmt::format("evsAtLine: expected an action node before '{}'", want));
+        shared_ptr<ActionNode> action_node = std::dynamic_pointer_cast<ActionNode>(node);
+
+        int taken = -1;
+        vector<string> labels;
+        for(int i = 0;i < action_node->getActions().size();i ++) {
+            string label = action_node->getActions()[i].toString();
+            labels.push_back(label);
+            if(label == want) taken = i;
+        }
+        if(taken < 0) {
+            string avail;
+            for(const string& l : labels) avail += (avail.empty() ? "" : ", ") + l;
+            throw runtime_error(fmt::format("evsAtLine: action '{}' not at this node (have: {})", want, avail));
+        }
+
+        int acting = action_node->getPlayer();
+        shared_ptr<Trainable> trainable = action_node->getTrainable(0);
+        if(trainable == nullptr) throw runtime_error("evsAtLine: null trainable while walking the line");
+        const vector<float>& node_strategy = trainable->getAverageStrategy();
+        int n = reach_probs[acting].size();
+        for(int i = 0;i < n;i ++)
+            reach_probs[acting][i] *= node_strategy[taken * n + i];
+
+        node = action_node->getChildrens()[taken];
+    }
+
+    if(node->getType() != GameTreeNode::GameTreeNodeType::ACTION)
+        throw runtime_error("evsAtLine: the line does not end on a decision node");
+    shared_ptr<ActionNode> target = std::dynamic_pointer_cast<ActionNode>(node);
+
+    this->ev_mode = true;
+    vector<string> labels;
+    vector<vector<float>> per_action;
+    for(int i = 0;i < target->getActions().size();i ++) {
+        labels.push_back(target->getActions()[i].toString());
+        per_action.push_back(
+                this->bestResponse(target->getChildrens()[i], player, reach_probs, initialBoard, 0));
+    }
+    this->ev_mode = false;
+
+    nlohmann::json out;
+    out["player"] = player;
+    out["node_player"] = target->getPlayer();
+    out["actions"] = labels;
+    // EVs are keyed by hand so the caller never has to guess at combo ordering --
+    // that ordering is an internal detail of the range converter and has bitten us
+    // before. Weight is carried along because a range can be fractional.
+    nlohmann::json evs = nlohmann::json::object();
+    vector<PrivateCards>& combos = this->private_combos[player];
+    vector<PrivateCards>& oppo_combos = this->private_combos[1 - player];
+    for(int h = 0;h < combos.size();h ++) {
+        uint64_t private_long = combos[h].toBoardLong();
+        // Hands that collide with the board are not real hands here.
+        if(Card::boardsHasIntercept(private_long,initialBoard)) continue;
+
+        // The traversal returns payoffs summed over the opponent's reach, so a
+        // single hand's EV is that sum divided by how much opponent range it was
+        // summed against -- the same normalisation getBestReponseEv applies before
+        // reporting exploitability. Without it every number comes out scaled by the
+        // size of the opponent's range, which looks plausible and is simply wrong.
+        //
+        // Divide by the *reach* at this node, not by the raw combo weights.
+        // getBestReponseEv can use the weights because it always starts at the root
+        // where the two are equal; here the line has already rescaled the opponent's
+        // reach by the strategy they took to get here, so weights would over-divide
+        // by exactly the frequency of that line. A root-only check cannot catch
+        // this -- it took a spot one action deep, where the numbers came out at
+        // precisely half of hand-computed truth.
+        const vector<float>& oppo_reach = reach_probs[1 - player];
+        float oppo_sum = 0;
+        for(int o = 0;o < oppo_combos.size();o ++) {
+            uint64_t oppo_long = oppo_combos[o].toBoardLong();
+            if(Card::boardsHasIntercept(private_long,oppo_long)
+               || Card::boardsHasIntercept(oppo_long,initialBoard)) continue;
+            oppo_sum += oppo_reach[o];
+        }
+        if(oppo_sum <= 0) continue;   // nothing left for this hand to play against
+
+        nlohmann::json row = nlohmann::json::array();
+        for(int a = 0;a < per_action.size();a ++)
+            row.push_back(per_action[a].empty() ? 0.0f : per_action[a][h] / oppo_sum);
+        evs[combos[h].toString()] = row;
+    }
+    out["evs"] = evs;
+    return out;
+}
