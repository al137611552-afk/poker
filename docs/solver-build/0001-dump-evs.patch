+// ---- holdem-trainer patch -----------------------------------------------------
+void PokerSolver::dump_evs(string dump_file,const vector<string>& line,int player) {
+    if(this->solver == nullptr) throw runtime_error("dump_evs: nothing solved yet");
+    // dynamic_cast rather than a virtual on Solver: the EV traversal is specific
+    // to the parallel CFR solver's data, and widening the base interface for one
+    // downstream tool is exactly the kind of upstream churn the patch should avoid.
+    PCfrSolver* pcfr = dynamic_cast<PCfrSolver*>(this->solver.get());
+    if(pcfr == nullptr) throw runtime_error("dump_evs: only supported for the parallel cfr solver");
+    json dump_json = pcfr->dumpEvs(line, player);
+    ofstream fileWriter;
+    fileWriter.open(dump_file);
+    fileWriter << dump_json;
+    fileWriter.flush();
+    fileWriter.close();
+}
