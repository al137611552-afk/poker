+// ---- holdem-trainer patch -----------------------------------------------------
+json PCfrSolver::dumpEvs(const vector<string>& line, int player) {
+    vector<vector<PrivateCards>> player_privates(this->player_number);
+    player_privates[0] = this->pcm.getPreflopCards(0);
+    player_privates[1] = this->pcm.getPreflopCards(1);
+
+    BestResponse br = BestResponse(player_privates,this->player_number,this->pcm,this->rrm,
+                                   this->deck,this->debug,this->color_iso_offset,
+                                   this->split_round,this->num_threads);
+    return br.evsAtLine(this->tree->getRoot(), player, this->initial_board_long, line);
+}
